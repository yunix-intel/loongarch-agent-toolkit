# install/versions.env -- single source of truth for agent versions.
#
# Every pin used by install/install-loongarch-agents.sh and the version table
# in README.md is derived from this file.  The values are deliberately the
# *latest version usable on LoongArch*, not necessarily the upstream latest:
#
#   * Codex      -- newest `@openai/codex` with a -linux-loong64 build.
#   * OpenCode   -- newest `opencode-linux-loong64` package.
#   * DSH        -- newest `@deepseek-ai/dsh` in the Loongnix registry.
#   * Claude Code-- newest release whose npm tarball still ships `cli.js`.
#                  2.1.113 and later are native-only (box64 only) and are not
#                  selected automatically.
#   * ZCode      -- newest builds release in loongarch-agent-builds carrying
#                  all three loong64 assets.  Upstream tags can run ahead of
#                  the build; a tag alone never moves the pin.
#   * cc-switch  -- newest loongarch-v<ver> release in cc-switch-loongarch
#                  that actually carries a loong64 deb.
#
# .github/scripts/check-agent-versions.sh updates this file on the
# auto/version-alignment branch when a newer usable version appears.
# .github/scripts/check-versions-consistency.sh fails CI if this file, the
# installer fallback block and the README table disagree.
#
# Keep the file POSIX-sh compatible (plain KEY=VALUE, no `export`).

NODE_VERSION=22.23.3

# Codex has two channels:
#   npm    -- @openai/codex from the Loongnix registry (default, stable).
#   source -- a LoongArch source build from the private builds repository.
#             CODEX_SOURCE_URL may be an http(s) URL or a local .tar.gz.
#             Private GitHub release assets need CODEX_SOURCE_TOKEN (or
#             GITHUB_TOKEN) when installing; the URL itself may be empty in the
#             manifest and supplied at install time.
CODEX_CHANNEL=npm
CODEX_VERSION=0.162.0
CODEX_SOURCE_VERSION=0.164.0
CODEX_SOURCE_URL=https://api.github.com/repos/yunix-intel/loongarch-agent-builds/releases/assets/668589231
CODEX_SOURCE_SHA256=55b9bbcc9f51ba528e9d7fcbc9e9f085ea7a67c13f95c858c75cee0640a75e09
# 1 = also make the default `codex` wrapper point at the source build.
CODEX_LINK_DEFAULT=0

OPENCODE_VERSION=1.19.0
DSH_VERSION=0.2.1-rc.2
CLAUDE_CODE_VERSION=2.1.112
CLAUDE_CODE_NPM_REGISTRY=https://registry.npmjs.org
CLAUDE_CODE_PREFIX=/opt/claude-code
# Empty = auto-detect /opt/node26, /opt/node24, /opt/node22-abi2.
CLAUDE_CODE_NODE=
CLAUDE_CODE_LINK_DEFAULT=1

# ZCODE_TAG is the upstream tag the selected builds release was built from;
# ZCODE_VERSION is the installable version (they must match).  The watch only
# moves them together with the three asset URL/SHA pairs below.
# install/install-zcode-loongarch.sh installs the CLI or a desktop deb from
# the private release assets.
ZCODE_TAG=v3.15.1
ZCODE_VERSION=v3.15.1

# Optional ZCode install channel.  Release assets live in the private
# yunix-intel/loongarch-agent-builds repository; fill these URLs/SHA256 after
# a build, or pass them explicitly to install-zcode-loongarch.sh.
ZCODE_CHANNEL=cli
ZCODE_CLI_URL=https://api.github.com/repos/yunix-intel/loongarch-agent-builds/releases/assets/665118865
ZCODE_CLI_SHA256=6b070c44b1e9fbd6b0040a8f20e39f03a224242f366584655da7a65b29a44cd0
ZCODE_DESKTOP_DEB_URL=https://api.github.com/repos/yunix-intel/loongarch-agent-builds/releases/assets/665141833
ZCODE_DESKTOP_DEB_SHA256=3fd8d3d9803e25ed7c1367bda731969180df3d7c7429e9bc142abff81be08ba5
ZCODE_STANDALONE_DEB_URL=https://api.github.com/repos/yunix-intel/loongarch-agent-builds/releases/assets/665142278
ZCODE_STANDALONE_DEB_SHA256=8a7fe66bdcccb249bd226459078bbafc24d6a063916d0c9a3116b38abdf4c2ee
ZCODE_LINK_DEFAULT=0

CC_SWITCH_VERSION=v4.0.19
CC_SWITCH_DEB_URL=https://api.github.com/repos/yunix-intel/cc-switch-loongarch/releases/assets/670983495
CC_SWITCH_DEB_SHA256=e16955e3d736a6f39b683d9de92a3557e0466b411c1fed6650809659a31535c8
