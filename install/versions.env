# install/versions.env -- single source of truth for agent versions.
#
# Every pin used by install/install-loongarch-agents.sh and the version table
# in README.md is derived from this file.  The values are deliberately the
# *latest version usable on LoongArch*, not necessarily the upstream latest:
#
#   * Codex      -- newest `@openai/codex` with a -linux-loong64 build.
#   * OpenCode   -- newest `opencode-linux-loong64` package.
#   * DSH        -- newest `@deepseek-ai/dsh` in the Loongnix registry.
#   * Claude Code-- newest release whose npm tarball still ships `cli.js`.
#                  2.1.113 and later are native-only (box64 only) and are not
#                  selected automatically.
#   * ZCode      -- newest builds release mirrored in the public
#                  loongarch-agent-toolkit `agent-binaries` release.
#                  Upstream tags can run ahead of the build; a tag alone never
#                  moves the pin.
#   * cc-switch  -- newest loongarch-v<ver> release mirrored in the same public
#                  release and actually carrying a loong64 deb.
#
# .github/scripts/check-agent-versions.sh updates this file on the
# auto/version-alignment branch when a newer usable version appears.
# .github/scripts/check-versions-consistency.sh fails CI if this file, the
# installer fallback block and the README table disagree.
#
# Keep the file POSIX-sh compatible (plain KEY=VALUE, no `export`).

NODE_VERSION=22.23.3
# SHA-256 of node-v22.23.3-linux-loong64.tar.xz from loong64/node.  Pinned so a
# re-uploaded third-party release is rejected; override both NODE_URL and
# NODE_SHA256 together if you use a different runtime.
NODE_SHA256=bbf4ecadfb5dcfe8420998f4539b927edbaea92c2a5f60057317be2fe41ad654

# Codex has two channels:
#   npm    -- @openai/codex from the Loongnix registry (default, stable).
#   source -- a LoongArch source build mirrored in the public toolkit
#             `agent-binaries` release.  CODEX_SOURCE_URL may be an http(s)
#             URL or a local .tar.gz.  Public assets need no token.
CODEX_CHANNEL=npm
CODEX_VERSION=0.167.0
# sha512 integrity of the exact Loongnix-registry tarballs.  The installer
# downloads with `npm pack`, verifies these values independently, then installs
# the local tarball; a republished registry tarball is rejected.
CODEX_NPM_INTEGRITY=sha512-lYoqiqSV3kYp+8nBf0AKjSBjvzUi0yAhMcHOMwIkQ8zuucxHmgWeL3bvFkFpV8WuVPRoLjRucvybPlDO3JWtyQ==
CODEX_SOURCE_VERSION=0.167.0
CODEX_SOURCE_URL=https://github.com/yunix-intel/loongarch-agent-toolkit/releases/download/agent-binaries/codex-rust-v0.167.0-loongarch64.tar.gz
CODEX_SOURCE_SHA256=2898fd45cd411a714a12dd97c65871e7614975d411f60397bff8117dc24e0ed0
# 1 = also make the default `codex` wrapper point at the source build.
CODEX_LINK_DEFAULT=0

OPENCODE_VERSION=1.19.0
OPENCODE_NPM_INTEGRITY=sha512-FNrnj7dzWbocxJR7Xqigb6bKGZJMZjmiCcFIGd7i1KdJ73wPOyTwwANQIfTaYqKn9g+FbFlkufrSUVDp8o6Cyg==
DSH_VERSION=0.2.2-rc.1
DSH_NPM_INTEGRITY=sha512-ijR9UEVYkG15Q/Q79JzvzLBzQOQfc63VLr9n6flpwHPhr5IKn2UxthnSoto/P9l7qGd7pPvI1Ra6TW7LH3oKpg==
CLAUDE_CODE_VERSION=2.1.112
CLAUDE_CODE_NPM_INTEGRITY=sha512-9FUgJ0EOvILyhIqxFKNVliebiUjL68dwpEW3eGSSe0vkVDJ1c5qMDNWc22gW3zkD7zRAqtfQPSGv0t4vMM2DPA==
CLAUDE_CODE_NPM_REGISTRY=https://registry.npmjs.org
CLAUDE_CODE_PREFIX=/opt/claude-code
# Empty = auto-detect /opt/node26, /opt/node24, /opt/node22-abi2.
CLAUDE_CODE_NODE=
CLAUDE_CODE_LINK_DEFAULT=1

# ZCODE_TAG is the upstream tag the selected builds release was built from;
# ZCODE_VERSION is the installable version (they must match).  The watch only
# moves them together with the three asset URL/SHA pairs below.
# install/install-zcode-loongarch.sh installs the CLI or a desktop deb from
# the public toolkit `agent-binaries` mirror.
ZCODE_TAG=v3.17.2
ZCODE_VERSION=v3.17.2

# Optional ZCode install channel.  Assets live in the public
# loongarch-agent-toolkit `agent-binaries` release; override the URLs/SHA256
# together when installing a different build.
ZCODE_CHANNEL=cli
ZCODE_CLI_URL=https://github.com/yunix-intel/loongarch-agent-toolkit/releases/download/agent-binaries/zcode-cli_3.17.2_loong64.tar.gz
ZCODE_CLI_SHA256=3b5c544c9aa0f6f78404d9678061969fe8764a21705759d92fef010d0c2a147c
ZCODE_DESKTOP_DEB_URL=https://github.com/yunix-intel/loongarch-agent-toolkit/releases/download/agent-binaries/zcode-desktop_3.17.2_loong64.deb
ZCODE_DESKTOP_DEB_SHA256=848264df1f69ec03e9247a0ec04845c78ecb7271533d784325e03ea36f226679
ZCODE_STANDALONE_DEB_URL=https://github.com/yunix-intel/loongarch-agent-toolkit/releases/download/agent-binaries/zcode-desktop-standalone_3.17.2_loong64.deb
ZCODE_STANDALONE_DEB_SHA256=9bd15a1c2d495caa298a79000fd23e5723c3c9eb3c8ae9d1367bb442a25b3626
ZCODE_LINK_DEFAULT=0

CC_SWITCH_VERSION=v4.0.28
CC_SWITCH_DEB_URL=https://github.com/yunix-intel/loongarch-agent-toolkit/releases/download/agent-binaries/cc-switch_4.0.28.loong64.1_loong64.deb
CC_SWITCH_DEB_SHA256=dc687a2a3b9970ae3283d1bfc31cf6134364bc0eff1ba718ff2d4c6b54d1f621
