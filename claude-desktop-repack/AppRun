#!/bin/sh
HERE="$(dirname "$(readlink -f "$0")")"
export LD_LIBRARY_PATH="$HERE/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
APP="$HERE/usr/lib/claude-desktop/claude-desktop"
# Do not disable the Chromium sandbox silently.  Set
# CLAUDE_DESKTOP_NO_SANDBOX=1 only when the host cannot use user namespaces.
if [ "${CLAUDE_DESKTOP_NO_SANDBOX:-0}" = "1" ]; then
  set -- --no-sandbox "$@"
fi
exec "$APP" "$@"
