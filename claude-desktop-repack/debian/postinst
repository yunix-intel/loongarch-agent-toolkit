#!/bin/sh
set -e
if [ "$1" = configure ]; then
  chmod 4755 /usr/lib/claude-desktop/chrome-sandbox || true
  command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database /usr/share/applications || true
  command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -f -t /usr/share/icons/hicolor || true
  if [ -f /usr/lib/claude-desktop/resources/linux-mime/com.anthropic.Claude.xml ] && command -v update-mime-database >/dev/null 2>&1; then
    cp /usr/lib/claude-desktop/resources/linux-mime/com.anthropic.Claude.xml /usr/share/mime/packages/com.anthropic.Claude.xml || true
    update-mime-database /usr/share/mime || true
  fi
fi
exit 0
